{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes",
  "mainBinaryName": "Hermes",
  "version": "0.3.0",
  "identifier": "com.megumisharp.hermes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Hermes",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
